pipeline {
    agent any
    environment {

        BRANCH_NAME = "${env.BRANCH_NAME}"
        GIT_HUB_URL="https://github.com/Anandhabadmanaban/3-Tier-DevSecOps-Mega-Project.git"
        IMAGE_REPO_FRONTEND = "${ECR_URL}/${REPO_USERNAME}/3_tier_app_frontend"
        IMAGE_REPO_BACKEND = "${ECR_URL}/${REPO_USERNAME}/3_tier_app_backend"
        ECR_URL = "442042548826.dkr.ecr.us-east-1.amazonaws.com"
        REPO_USERNAME = "anandhabadmanaban"
    }
    
    
    stages {
       
        
        stage('Frontend Compilation AND Push to ECR') {
            steps {

 
     dir('client') {

            withCredentials([aws(accessKeyVariable: 'AWS_ACCESS_KEY_ID', credentialsId: 'ECR_442042548826', secretKeyVariable: 'AWS_SECRET_ACCESS_KEY')]) {
               
                sh 'docker login -u AWS -p $(aws ecr get-login-password --region us-east-1) ${ECR_URL}'
     sh "docker build -t ${REPO_USERNAME}/3_tier_app_frontend:${BUILD_NUMBER} ."
     sh "docker tag ${REPO_USERNAME}/3_tier_app_frontend:${BUILD_NUMBER} ${IMAGE_REPO_FRONTEND}:${BUILD_NUMBER}"
    sh "docker push ${ECR_URL}/${REPO_USERNAME}/3_tier_app_frontend:${BUILD_NUMBER}"
}
                   
                    
                }
}

               
            }


        
        
        stage('Backend Compilation AND Push to ECR') {
            steps {
                dir('api') {
                     withCredentials([aws(accessKeyVariable: 'AWS_ACCESS_KEY_ID', credentialsId: 'ECR_442042548826', secretKeyVariable: 'AWS_SECRET_ACCESS_KEY')]) {
                       sh 'aws ecr get-login-password --region us-east-1 | docker login --username AWS --password-stdin ${ECR_URL}'
                   sh "docker build -t ${REPO_USERNAME}/3_tier_app_backend:${BUILD_NUMBER} ."
                  sh "docker tag ${REPO_USERNAME}/3_tier_app_backend:${BUILD_NUMBER} ${IMAGE_REPO_BACKEND}:${BUILD_NUMBER}"
                  sh "docker push ${IMAGE_REPO_BACKEND}:${BUILD_NUMBER}"
                     }
                }
            }
        }

        stage('Update values.yaml and Push to GitHub') {
            steps {
                script {
                    // Update the image tag in values.yaml (assuming path is ./helm/values.yaml)
                    sh """
                        sed -i 's/tag: .*/tag: ${BUILD_NUMBER}/' ./api/3-tier-backend-chart/values.yaml
                         sed -i 's/tag: .*/tag: ${BUILD_NUMBER}/' ./client/3-tier-frontend-chart/values.yaml
                    """
                    // Configure git
                    withCredentials([usernamePassword(credentialsId: 'gitcred', usernameVariable: 'GIT_USER', passwordVariable: 'GIT_TOKEN')]) {
                    sh """

                        git remote set-url origin https://${GIT_USER}:${GIT_TOKEN}@github.com/Anandhabadmanaban/3-Tier-DevSecOps-Mega-Project.git
                        git add ./api/3-tier-backend-chart/values.yaml ./client/3-tier-frontend-chart/values.yaml
                        git commit -m "Update image tag to ${BUILD_NUMBER} [ci skip]" || echo "No changes to commit"
                        git push origin HEAD:${BRANCH_NAME} || echo "No changes to push"
                    """
                }
            }
        }
        }


